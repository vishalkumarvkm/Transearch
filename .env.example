# Google Gemini API Key for Multimodal Live Realtime Voice API
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Application Base URL
NEXT_PUBLIC_APP_URL=https://transearchai.com

# Backend API Service (Server IP: 187.126.124.110, Port: 8000)
PYTHON_BACKEND_URL=http://187.126.124.110:8000
NEXT_PUBLIC_BACKEND_URL=http://187.126.124.110:8000

# Authentication JWT Secret (aligned with Python FastAPI backend)
JWT_SECRET=transearch-executive-secret-key-2025-secure

# Database Configuration (Transcripts and Call Audits are saved directly to MongoDB)
MONGODB_URI=mongodb://localhost:27018
MONGODB_DB_NAME=transearch_voice_db

# Email Dispatch Settings (Disabled: transcripts and leads are stored directly in DB)
ENABLE_EMAIL_TRANSCRIPTS=false
